      "fontSize": 16,
      "fontFamily": 5,
      "text": "Framing Entity-Matching As an Ordinal Regression Problem: Resolving Clustering conflicts & Assigning Cluster Identifiers.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "WoXdYlNZnRpekeSpEc-Kv",
      "originalText": "Framing Entity-Matching As an Ordinal Regression Problem: Resolving Clustering conflicts & Assigning Cluster Identifiers.",
      "lineHeight": 1.25,
      "baseline": 15,
      "index": "aX",
      "autoResize": true
    },
    {
      "type": "text",
      "version": 609,
      "versionNonce": 659772436,
      "isDeleted": false,
      "id": "6-EOG3yz9k3aO5exhoLw6",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 305.9380871449689,
      "y": -116.13713425790229,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "width": 455.8828125,
      "height": 140,
      "seed": 2054453824,
      "groupIds": [
        "8IkSGqg3GKESM2x8u5h6H"
